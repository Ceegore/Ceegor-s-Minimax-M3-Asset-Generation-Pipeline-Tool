{
  "name": "ceegor-minimax-m3-asset-generation-pipeline-tool",
  "version": "1.0.0",
  "description": "Windows batch asset production for MiniMax with local image processing, organized exports, and pipeline reports.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "status": "node scripts/status.js",
    "setup": "node scripts/setup.js",
    "check": "node scripts/check.js",
    "lint": "node scripts/lint.js",
    "test": "node --test --test-concurrency=6 \"tests/unit/**/*.test.js\"",
    "test:affected": "node scripts/test-affected.js",
    "test:contract": "node scripts/run-contract.js",
    "test:smoke": "node scripts/run-smoke.js",
    "test:e2e": "node scripts/e2e/launch.js",
    "test:e2e:real": "node scripts/e2e/launch.js --real",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.js\"",
    "test:coverage:gate": "node scripts/check-unit-coverage.js",
    "test:ipc-coverage": "node scripts/e2e/ipc-coverage.js --threshold=97",
    "test:packaged": "node scripts/e2e/packaged-boot.js",
    "test:installer": "node scripts/test-release-installer.js",
    "test:visual": "node scripts/e2e/launch.js",
    "test:visual:capture": "node scripts/e2e/launch.js --visual-capture",
    "check:deps": "node scripts/check-bundled-deps.js",
    "prebuild": "node scripts/check.js",
    "build": "node scripts/zip-portable.js",
    "build:release": "node scripts/zip-portable.js",
    "build:dev": "node scripts/build-dev-zip.js",
    "build:full": "electron-builder --win dir --x64",
    "verify:release": "node scripts/verify-release.js --require-archive",
    "enable-devmode": "node scripts/enable-devmode.js"
  },
  "keywords": [
    "minimax",
    "mmx",
    "asset-generation",
    "electron",
    "image-pipeline",
    "upscale",
    "crop",
    "format-conversion",
    "background-removal",
    "isnet"
  ],
  "author": "Ceegor",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "mmx-cli": "^1.0.16",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "onnxruntime-node": {
      "adm-zip": "^0.6.0"
    }
  },
  "build": {
    "appId": "com.ceegor.minimax-asset-tool",
    "productName": "MiniMaxAssetTool",
    "directories": {
      "output": "dist-out"
    },
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "logo.webp",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "IMAGE_STYLE_PRESETS_ENGLISH_v2.0.md",
      "node_modules/mmx-cli/**",
      "node_modules/@clack/**",
      "node_modules/bun-plugin-dts/**",
      "node_modules/es-toolkit/**",
      "node_modules/undici/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/@img/sharp-wasm32/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "node_modules/@img/**",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/mmx-cli/**",
      "node_modules/@clack/**",
      "node_modules/bun-plugin-dts/**",
      "node_modules/es-toolkit/**",
      "node_modules/undici/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MiniMaxAssetTool-${version}-${arch}.${ext}"
    }
  }
}
